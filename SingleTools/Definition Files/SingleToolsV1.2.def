BootStrap: docker
From: ubuntu:20.04

#Copy needed env files into the machine
%files 
    ./EnvPack/renv1.2.lock /opt/
    ./EnvPack/gitCredsHelper.sh /opt/

#Commands to run
%post
    TZ=Europe/Berlin
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
    apt update -y && apt upgrade -y
    apt install -y wget build-essential git curl procps git 
    apt install -y software-properties-common
    add-apt-repository universe

    apt-get install -y libgsl-dev libglpk-dev libxml2-dev libhdf5-dev default-jre default-jdk
    apt-get install -y libudunits2-dev libgdal-dev libgeos-dev libproj-dev
    apt-get install -y libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev libharfbuzz-dev libfribidi-dev
    apt-get install -y python3 python3-venv python3-pip python3-dev
    apt-get install -y bzip2 tabix
    #apt install ......
   

    #Allow PIP to modyfy system packages
    export PIP_BREAK_SYSTEM_PACKAGES=1

    pip install --no-cache-dir jupyterlab jupyterlab-git jupyterlab-quarto numpy scanpy

    #Add python package path
    export PATH=/usr/local/lib/python3.8/dist-packages:$PATH

    mkdir /workspace
    ls /opt/renv1.2.lock
 

    ################
    #Set Git credentials
    ################

    echo "Setting up GitHub PAT for devtools"

    bash /opt/gitCredsHelper.sh

    #######################
    #Install R
    #######################

    # Software versions
    export R_VERSION=4.5
    echo "export R_VERSION=${R_VERSION}" >> $SINGULARITY_ENVIRONMENT
    # Install R
    apt-get update
    apt-get install -y --no-install-recommends \
      software-properties-common \
      dirmngr \
      wget
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | \
      tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository \
      "deb https://cloud.r-project.org/bin/linux/ubuntu focal-cran40/"
    cat /etc/apt/sources.list
    apt-get update
    apt-get upgrade
    apt-get install -y \
      r-base=${R_VERSION}* \
      r-base-core=${R_VERSION}* \
      r-base-dev=${R_VERSION}* \
      r-recommended=${R_VERSION}* \
      r-base-html=${R_VERSION}* \
      r-doc-html=${R_VERSION}* \
      libcurl4-openssl-dev \
      libssl-dev \
      libxml2-dev \
      libcairo2-dev \
      libxt-dev \
      libopenblas-dev

    # Add a default CRAN mirror
    echo "options(repos = c(CRAN = 'https://cran.rstudio.com/'), download.file.method = 'libcurl')" >> /usr/lib/R/etc/Rprofile.site

    # Add a directory for host R libraries
    mkdir -p /library
    echo "R_LIBS_SITE=/library:\${R_LIBS_SITE}" >> /usr/lib/R/etc/Renviron.site


    # Install Packages
    # Install R packages for Jupyter integration
    R -e "install.packages(c('IRkernel', 'IRdisplay'), repos='https://cloud.r-project.org/')"

    # Set up IRkernel to make R available as a Jupyter kernel
    R -e "IRkernel::installspec(user = FALSE)"

    #Install R library
    R --quiet --slave -e 'install.packages("renv", lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")' 
    R --quiet --slave -e 'install.packages("BiocManager",lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'
    R --quiet --slave -e 'install.packages("devtools",lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'
    R --quiet --slave -e 'install.packages("RSQLite", lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'
    R --quiet --slave -e 'install.packages("remotes",lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'
    R --quiet --slave -e 'install.packages("seurat",lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'
    R --quiet --slave -e 'install.packages("seurat-disk",lib= "/usr/lib/R/library/",repos="https://cloud.r-project.org/")'

    R -e 'BiocManager::install("Biostrings", library = "/usr/lib/R/library/")' 
    R -e 'BiocManager::install("Rhdf5lib", library = "/usr/lib/R/library/")'
    R -e 'BiocManager::install("rhdf5", library = "/usr/lib/R/library/")'
    R -e 'BiocManager::install("leiden", library = "/usr/lib/R/library/")'
    R -e 'BiocManager::install("AnnotationDbi",library = "/usr/lib/R/library/")'

    R -e 'remotes::install_github("satijalab/seurat", "seurat5", quiet = TRUE)'
    R -e 'remotes::install_github("mojaveazure/seurat-disk")'
    R -e 'BiocManager::install(c("rhdf5", "SingleCellExperiment"))'
    R -e 'devtools::install_github("cellgeni/schard",library = "/usr/lib/R/library/")'


# check iof the file has been copied...
# if [ -f /opt/renv1.2.lock ]; then
#    R -e 'renv::restore(lockfile = "/opt/renv1.2.lock", library = "/usr/lib/R/library/")'
# else
#    echo "ERROR: /opt/renv.lock not found. Aborting setup." >&2
#    exit 1
# fi


    
    # Clean up
    rm -rf /var/lib/apt/lists/*


%runscript
    jupyter lab --port 3333 --ip=0.0.0.0 --allow-root --no-browser

%environment
    #PATH=/opt/mamba24/bin:$PATH
    export PATH="/usr/local/bin:$PATH"
    export PIP_BREAK_SYSTEM_PACKAGES=1

%labels
    Author: David Hidalgo
    Version 1.2